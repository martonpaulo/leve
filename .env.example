# A stable local code signature, so macOS keeps Leve's calendar, notification and login-item
# permissions across rebuilds: an Apple Development identity. List identities with
#   security find-identity -v -p codesigning
LOCAL_SIGNING_IDENTITY=
# A Developer ID Application identity, used only when LOCAL_SIGNING_IDENTITY is empty: for a local
# release rehearsal (make dmg). The release workflow sets its own.
DEVELOPER_ID_IDENTITY=
